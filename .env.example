# Copy to .env and fill in. Never commit the real .env.

# --- Reddit (OAuth2 script app) ---
# Create an app at https://www.reddit.com/prefs/apps (type: "script").
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit throttles generic agents hard. Use something descriptive and unique.
REDDIT_USER_AGENT=keyword-scrub/0.1 by u/yourname

# --- X/Twitter (API v2, paid tier with recent search) ---
# Leave blank to run the NullBackend: the source reports as "unavailable".
TWITTER_BEARER_TOKEN=

# --- 4chan ---
# Comma-separated default boards to crawl when the caller names none.
# Crawling all boards is refused on purpose; pick an explicit set.
FOURCHAN_DEFAULT_BOARDS=g,pol,news

# --- HTTP / caching ---
HTTP_TIMEOUT=20
CACHE_TTL=60
# User-Agent sent on every outbound request.
HTTP_USER_AGENT=keyword-scrub/0.1 (+https://github.com/yourname/keyword-scrub)

# --- Persistence (Phase 6) ---
DATABASE_URL=sqlite:///keyword_scrub.db

# --- API auth (optional; a static key header) ---
API_KEY=
